ound:\n    radial-gradient(80% 100% at 50% 0%, var(--accent-tint) 0%, transparent 60%),\n    linear-gradient(180deg, rgba(255,255,255,0.95), rgba(255,255,255,0.8));\n  border-color: rgba(139, 61, 245, 0.3);\n  position: relative;\n  box-shadow: 0 20px 50px rgba(139, 61, 245, 0.18);\n}\n.tier.featured::after {\n  content: \"Most popular\";\n  position: absolute;\n  top: -1px; right: 24px;\n  background: linear-gradient(180deg, var(--accent), var(--accent-deep));\n  color: #fff;\n  font-size: 11px;\n  font-family: var(--font-mono);\n  letter-spacing: .04em;\n  padding: 4px 12px;\n  border-radius: 0 0 8px 8px;\n}\n.tier h4 {\n  font-family: var(--font-display);\n  font-size: 16px;\n  font-weight: 500;\n  margin: 0 0 8px;\n  color: var(--text-dim);\n}\n.tier .tier-name {\n  font-family: var(--font-display);\n  font-size: 30px;\n  font-weight: 600;\n  letter-spacing: -0.025em;\n  margin: 0 0 18px;\n  color: var(--ink);\n}\n.tier .price {\n  font-family: var(--font-display);\n  font-size: 60px;\n  font-weight: 600;\n  letter-spacing: -0.04em;\n  line-height: 1;\n  color: var(--ink);\n}\n.tier .price sub {\n  font-family: var(--font-mono);\n  font-size: 13px;\n  color: var(--text-mute);\n  font-weight: 400;\n  bottom: 0;\n  margin-left: 8px;\n}\n.tier ul { list-style: none; padding: 0; margin: 28px 0; display: flex; flex-direction: column; gap: 12px; flex: 1; }\n.tier li { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--text-dim); }\n.tier li::before { content: \"✓\"; color: var(--accent); font-family: var(--font-mono); font-size: 14px; line-height: 1.4; font-weight: 700; }\n\n/* ── FAQ ────────────────────────────────────────────────────── */\n.faq-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 80px; align-items: start; }\n.faq-list { display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--line); }\n.faq-item { border-bottom: 1px solid var(--line); padding: 22px 0; cursor: default; }\n.faq-q { display: flex; justify-content: space-between; align-items: center; gap: 16px; font-family: var(--font-display); font-size: 18px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); }\n.faq-q .plus { font-family: var(--font-mono); font-size: 20px; color: var(--text-mute); transition: transform .2s, color .2s; }\n.faq-item.open .faq-q .plus { transform: rotate(45deg); color: var(--accent); }\n.faq-a { margin-top: 0; font-size: 15px; color: var(--text-dim); line-height: 1.55; max-height: 0; overflow: hidden; transition: max-height .25s ease, margin-top .2s; }\n.faq-item.open .faq-a { max-height: 200px; margin-top: 12px; }\n\n/* ── FINAL CTA + CHAT ───────────────────────────────────────── */\n.cta-final { position: relative; padding: 120px 0; overflow: hidden; }\n.cta-final-inner {\n  position: relative;\n  border-radius: var(--radius-xl);\n  padding: 96px 64px;\n  background:\n    radial-gradient(60% 80% at 50% 100%, rgba(139, 61, 245, 0.4) 0%, transparent 60%),\n    radial-gradient(80% 100% at 0% 0%, rgba(247, 178, 123, 0.5) 0%, transparent 70%),\n    radial-gradient(80% 100% at 100% 0%, rgba(255, 207, 162, 0.5) 0%, transparent 70%),\n    linear-gradient(180deg, #fce5cc, #f6dabf);\n  border: 1px solid rgba(255, 255, 255, 0.7);\n  text-align: center;\n  overflow: hidden;\n  box-shadow:\n    0 1px 0 rgba(255, 255, 255, 0.6) inset,\n    0 40px 80px rgba(139, 61, 245, 0.15);\n}\n.cta-final-inner > * { position: relative; z-index: 1; }\n.cta-final .h-section { margin-bottom: 18px; color: var(--ink); }\n.cta-final .lede { margin: 0 auto 32px; color: rgba(26, 15, 46, 0.65); }\n.cta-final .hero-cta { justify-content: center; }\n\n.cta-chat .chat-card {\n  margin: 24px auto 0;\n  max-width: 780px;\n  width: 100%;\n  background: rgba(255, 255, 255, 0.78);\n  border: 1px solid rgba(255, 255, 255, 0.9);\n  border-radius: 26px;\n  padding: 20px;\n  box-shadow:\n    0 1px 0 rgba(255, 255, 255, 0.9) inset,\n    0 30px 60px rgba(139, 61, 245, 0.18),\n    0 0 0 8px rgba(255, 255, 255, 0.3);\n  backdrop-filter: blur(20px);\n  text-align: left;\n}\n.chat-row { display: flex; align-items: center; gap: 12px; }\n.chat-row-bottom { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }\n.chat-input {\n  flex: 1;\n  background: transparent;\n  border: 0;\n  outline: 0;\n  color: var(--text);\n  font-size: 18px;\n  font-family: var(--font-body);\n  letter-spacing: -0.01em;\n  padding: 8px 4px;\n  min-width: 0;\n}\n.chat-input::placeholder { color: var(--text-mute); }\n.chat-use {\n  background: rgba(255,255,255,0.7);\n  border: 1px solid var(--line-strong);\n  color: var(--text-dim);\n  font-family: var(--font-mono);\n  font-size: 12px;\n  padding: 8px 14px;\n  border-radius: 999px;\n  cursor: pointer;\n  transition: background .15s, color .15s;\n}\n.chat-use:hover { color: var(--text); background: rgba(255,255,255,1); }\n.chat-tags { display: flex; gap: 8px; flex-wrap: wrap; flex: 1; }\n.chat-tag {\n  background: rgba(255, 255, 255, 0.7);\n  border: 1px solid var(--line-strong);\n  color: var(--text-dim);\n  padding: 9px 16px;\n  font-size: 14px;\n  font-family: var(--font-body);\n  border-radius: 999px;\n  cursor: pointer;\n  transition: background .15s, color .15s, border-color .15s, transform .12s;\n}\n.chat-tag:hover {\n  color: var(--accent-deep);\n  background: #fff;\n  border-color: rgba(139, 61, 245, 0.25);\n  transform: translateY(-1px);\n}\n.chat-build {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: var(--ink);\n  color: #fff;\n  font-family: var(--font-display);\n  font-weight: 600;\n  font-size: 14px;\n  padding: 12px 22px;\n  border: 0;\n  border-radius: 999px;\n  cursor: pointer;\n  box-shadow: 0 10px 24px rgba(26, 15, 46, 0.3);\n  transition: transform .12s, background .15s;\n}\n.chat-build:hover { transform: translateY(-1px); background: #000; }\n.chat-build .arrow { display: inline-block; transition: transform .2s; }\n.chat-build:hover .arrow { transform: translateX(2px); }\n\n.chat-foot {\n  margin-top: 26px;\n  display: inline-flex;\n  align-items: center;\n  gap: 16px;\n  font-family: var(--font-mono);\n  font-size: 12px;\n  color: rgba(26, 15, 46, 0.5);\n  letter-spacing: 0.02em;\n}\n.chat-foot strong { color: var(--ink); font-weight: 500; }\n.chat-foot .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 8px; background: var(--text-mute); vertical-align: 1px; }\n.chat-foot .dot.ok { background: #2ea860; box-shadow: 0 0 8px rgba(46, 168, 96, 0.5); }\n.chat-foot .sep { width: 1px; height: 14px; background: var(--line-strong); }\n\n/* ── FOOTER ─────────────────────────────────────────────────── */\nfooter { padding: 80px 0 40px; border-top: 1px solid var(--line); }\n.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 64px; }\n.footer-grid .col-brand { max-width: 320px; }\n.footer-grid .col-brand p { color: var(--text-dim); font-size: 14px; margin: 18px 0 24px; }\n.footer-col h5 {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n  color: var(--text-mute);\n  margin: 0 0 14px;\n  font-weight: 500;\n}\n.footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }\n.footer-col a { color: var(--text-dim); text-decoration: none; font-size: 14px; }\n.footer-col a:hover { color: var(--text); }\n.footer-bottom { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-family: var(--font-mono); color: var(--text-mute); padding-top: 24px; border-top: 1px solid var(--line); }\n.footer-bottom .socials { display: flex; gap: 16px; }\n.footer-bottom .socials a { color: var(--text-mute); text-decoration: none; }\n.footer-bottom .socials a:hover { color: var(--text); }\n\n/* ── DENSITY VARIATIONS ─────────────────────────────────────── */\n.density-comfy section { padding: 160px 0; }\n.density-compact section { padding: 80px 0; }\n.density-compact .hero { padding-top: 64px; padding-bottom: 100px; }\n.density-comfy .hero { padding-top: 120px; padding-bottom: 180px; }\n\n/* ── RESPONSIVE ─────────────────────────────────────────────── */\n@media (max-width: 980px) {\n  .hero-b .container, .hero-c .container { grid-template-columns: 1fr; gap: 60px; }\n  .features-grid { grid-template-columns: 1fr; }\n  .feature.span-6, .feature.span-4 { grid-column: span 1; }\n  .steps, .tiers { grid-template-columns: 1fr; }\n  .stats { grid-template-columns: repeat(2, 1fr); }\n  .stat:nth-child(2) { border-right: 0; }\n  .stat:nth-child(-n+2) { border-bottom: 1px solid var(--line); }\n  .footer-grid { grid-template-columns: 1fr 1fr; }\n  .faq-grid { grid-template-columns: 1fr; gap: 32px; }\n  .nav-links { display: none; }\n}\n\n@media (max-width: 720px) {\n  .site-mock { width: 480px; height: 320px; }\n  .lp-h1 { font-size: 32px; }\n  .lp-fullbleed .lp-h1 { font-size: 36px; }\n  .lp-h2 { font-size: 22px; }\n  .chat-row-bottom { flex-direction: column; align-items: stretch; gap: 14px; }\n  .chat-build { align-self: flex-end; }\n}\n\n@media (max-width: 640px) {\n  section { padding: 80px 0; }\n  .cta-final-inner { padding: 60px 24px; }\n}\n<\u002Fstyle>\n\n<!-- Resources lifted for standalone bundling (referenced from JSX) -->\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<script src=\"7df89c06-9593-4462-8488-312132a89b35\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"a4c8c3dc-f91d-4e92-9efe-c8bed5ca8809\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"3ca1143d-9192-4d31-b99b-7124e11ec37c\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n<\u002Fhead>\n<body>\n\n<div id=\"root\"><\u002Fdiv>\n\n<script type=\"text/babel\" src=\"217b3157-e280-4e31-a8c5-5f02f84527c2\"