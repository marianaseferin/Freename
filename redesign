ckground-clip: text;\n  background-clip: text;\n  color: transparent;\n  font-weight: 600;\n}\n.lede {\n  font-size: clamp(17px, 1.4vw, 20px);\n  color: var(--text-dim);\n  max-width: 56ch;\n  line-height: 1.55;\n  text-wrap: pretty;\n}\n.section-head {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  margin-bottom: 72px;\n}\n.section-head .lede { text-align: center; margin: 0 auto; }\n\n/* ── HERO ────────────────────────────────────────────────────── */\n.hero {\n  padding-top: 80px;\n  padding-bottom: 140px;\n  position: relative;\n}\n\n.hero-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 0;\n  background: rgba(255, 255, 255, 0.6);\n  border: 1px solid var(--line-strong);\n  border-radius: 999px;\n  padding: 4px 4px 4px 4px;\n  font-size: 12px;\n  color: var(--text-dim);\n  margin-bottom: 32px;\n  backdrop-filter: blur(8px);\n}\n.hero-eyebrow .pill {\n  background: var(--accent-tint);\n  color: var(--accent-deep);\n  padding: 4px 10px;\n  border-radius: 999px;\n  font-family: var(--font-mono);\n  letter-spacing: 0.04em;\n  font-size: 11px;\n  margin-right: 8px;\n}\n.hero-eyebrow .arrow { padding-right: 10px; color: var(--text-mute); }\n\n.hero-a .container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n}\n.hero-a .lede { text-align: center; margin: 28px auto 40px; }\n.hero-a .hero-cta { justify-content: center; }\n\n/* ── HERO CHAT BAR (brand signature) ─────────────────────────── */\n.hero-search {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: rgba(255, 255, 255, 0.75);\n  border: 1px solid rgba(255, 255, 255, 0.9);\n  border-radius: 22px;\n  padding: 14px 14px 14px 24px;\n  width: min(720px, 100%);\n  box-shadow:\n    0 1px 0 rgba(255, 255, 255, 0.9) inset,\n    0 30px 80px rgba(139, 61, 245, 0.15),\n    0 0 0 12px rgba(255, 255, 255, 0.25);\n  backdrop-filter: blur(20px);\n}\n.hero-search input {\n  flex: 1;\n  background: transparent;\n  border: 0;\n  outline: 0;\n  color: var(--text);\n  font-size: 18px;\n  font-family: var(--font-body);\n  letter-spacing: -0.01em;\n  min-width: 0;\n}\n.hero-search input::placeholder { color: var(--text-mute); }\n.hero-search .tld-pick {\n  display: flex;\n  gap: 6px;\n  font-family: var(--font-body);\n  font-size: 12px;\n  color: var(--text-mute);\n}\n.hero-search .tld-pick .chip {\n  padding: 6px 12px;\n  background: rgba(255, 255, 255, 0.8);\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  cursor: default;\n}\n.hero-search .tld-pick .chip.active {\n  color: var(--accent-deep);\n  background: var(--accent-tint);\n  border-color: rgba(139, 61, 245, 0.2);\n}\n\n.hero-suggest {\n  margin-top: 20px;\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  justify-content: center;\n  font-size: 13px;\n  color: var(--text-mute);\n}\n.hero-suggest span {\n  padding: 6px 14px;\n  background: rgba(255, 255, 255, 0.55);\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  backdrop-filter: blur(8px);\n}\n.hero-suggest span:hover {\n  color: var(--accent-deep);\n  border-color: rgba(139, 61, 245, 0.3);\n  background: rgba(255, 255, 255, 0.8);\n}\n\n.hero-cta {\n  display: flex;\n  gap: 12px;\n  margin-top: 8px;\n  flex-wrap: wrap;\n}\n\n.hero-trust {\n  margin-top: 64px;\n  display: flex;\n  gap: 32px;\n  align-items: center;\n  flex-wrap: wrap;\n  justify-content: center;\n  color: var(--text-mute);\n  font-size: 13px;\n}\n.hero-trust .sep { width: 1px; height: 14px; background: var(--line-strong); }\n\n/* hero B + C — keep but light-themed */\n.hero-b .container,\n.hero-c .container {\n  display: grid;\n  grid-template-columns: 1.05fr 1fr;\n  gap: 80px;\n  align-items: center;\n}\n.hero-b .h-display { text-align: left; }\n.hero-b .lede { margin: 28px 0 36px; }\n\n.tld-stack {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 1 / 1;\n  max-width: 520px;\n  margin-left: auto;\n}\n.tld-card {\n  position: absolute;\n  border-radius: 24