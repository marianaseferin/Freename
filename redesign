46, 0.35);\n  width: 100%;\n  max-width: 560px;\n  margin-left: auto;\n  color: #e8e2f4;\n}\n.terminal-bar {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 10px 14px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  background: rgba(255, 255, 255, 0.02);\n}\n.terminal-bar .dot { width: 10px; height: 10px; border-radius: 50%; }\n.terminal-bar .title { margin-left: 8px; font-size: 11px; color: rgba(255,255,255,0.5); }\n.terminal-body { padding: 22px 24px; min-height: 320px; }\n.term-line { white-space: pre-wrap; }\n.term-prompt { color: var(--accent-soft); }\n.term-cmd { color: #fff; }\n.term-out { color: rgba(255,255,255,0.7); }\n.term-ok { color: #6ddc89; }\n.term-warn { color: #ffd66e; }\n.term-comment { color: rgba(255,255,255,0.4); }\n.term-caret {\n  display: inline-block;\n  width: 8px; height: 14px;\n  background: var(--accent-soft);\n  vertical-align: -2px;\n  animation: blink 1s steps(2) infinite;\n}\n@keyframes blink { 50% { opacity: 0; } }\n\n/* ── TRUST STRIP ─────────────────────────────────────────────── */\n.trust {\n  padding: 60px 0 40px;\n  border-bottom: 1px solid var(--line);\n}\n.trust-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 40px;\n  flex-wrap: wrap;\n  font-size: 12px;\n}\n.trust-label {\n  color: var(--text-mute);\n  letter-spacing: .04em;\n  text-transform: uppercase;\n  font-family: var(--font-mono);\n}\n.trust-logos { display: flex; gap: 36px; align-items: center; flex-wrap: wrap; }\n.trust-logo {\n  color: var(--text-dim);\n  font-family: var(--font-display);\n  font-weight: 600;\n  font-size: 17px;\n  letter-spacing: -0.01em;\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  opacity: 0.85;\n}\n.trust-logo:hover { opacity: 1; color: var(--text); }\n.trust-logo .glyph {\n  width: 30px; height: 30px;\n  border-radius: 10px;\n  background: rgba(255, 255, 255, 0.7);\n  border: 1px solid var(--line);\n  color: var(--accent-deep);\n  display: inline-grid;\n  place-items: center;\n  backdrop-filter: blur(8px);\n}\n\n/* ── FEATURES ───────────────────────────────────────────────── */\n.features-grid {\n  display: grid;\n  grid-template-columns: repeat(12, 1fr);\n  gap: 18px;\n}\n.feature {\n  border: 1px solid var(--line);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.65));\n  border-radius: var(--radius-lg);\n  padding: 40px;\n  position: relative;\n  overflow: hidden;\n  transition: border-color .2s, transform .2s, box-shadow .2s;\n  backdrop-filter: blur(20px);\n  box-shadow: 0 1px 0 rgba(255,255,255,0.8) inset, 0 10px 40px rgba(26, 15, 46, 0.06);\n}\n.feature:hover {\n  border-color: rgba(139, 61, 245, 0.2);\n  transform: translateY(-3px);\n  box-shadow: 0 1px 0 rgba(255,255,255,0.8) inset, 0 24px 50px rgba(139, 61, 245, 0.12);\n}\n.feature h3 {\n  font-family: var(--font-display);\n  font-size: clamp(28px, 2.4vw, 36px);\n  font-weight: 600;\n  letter-spacing: -0.03em;\n  line-height: 1.05;\n  margin: 0 0 14px;\n  text-wrap: balance;\n  color: var(--ink);\n}\n.feature p {\n  color: var(--text-dim);\n  font-size: 16px;\n  margin: 0;\n  line-height: 1.55;\n}\n.feature .feat-icon {\n  width: 64px; height: 64px;\n  display: grid; place-items: center;\n  background: linear-gradient(180deg, var(--accent), var(--accent-deep));\n  border-radius: 18px;\n  margin-bottom: 28px;\n  font-family: var(--font-mono);\n  font-size: 26px;\n  color: #fff;\n  box-shadow:\n    0 1px 0 rgba(255, 255, 255, 0.3) inset,\n    0 12px 28px var(--accent-glow);\n}\n.feat-royalty .feat-icon { width: 72px; height: 72px; font-size: 30px; border-radius: 20px; }\n.feat-royalty h3 { font-size: clamp(32px, 2.8vw, 44px); }\n\n.feature .feat-visual { margin-top: 28px; min-height: 120px; }\n.feature.span-6 { grid-column: span 6; }\n.feature.span-4 { grid-column: span 4; }\n.feature.span-12 { grid-column: span 12; }\n\n.feat-royalty .feat-visual {\n  display: flex;\n  align-items: center;\n  gap: 32px;\n  fle